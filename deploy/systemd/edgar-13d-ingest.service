[Unit]
Description=EDGAR Schedule 13D/13G beneficial-ownership ingest
Documentation=file:///opt/edgar-13d/docs/DAILY_OPS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=edgar13d
Group=edgar13d
Nice=10
EnvironmentFile=-/opt/edgar-13d/etc/edgar-13d.env
WorkingDirectory=/opt/edgar-13d
ExecStart=/opt/edgar-13d/scripts/run-ingest.sh
TimeoutStartSec=1h
SyslogIdentifier=edgar-13d-ingest
ReadWritePaths=/var/lib/edgar-13d /var/lib/state-capture/announce -/run/state
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
